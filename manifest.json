{
  "manifest_version": 3,
  "name": "德州托管助手",
  "version": "1.1.0",
  "description": "River 德州自动托管：根据你的底牌、公共牌、底池和对手行为实时算胜率并给出建议，开启托管后自动弃牌/过牌/跟注/加注，出手前先预告、随时可叫停。",

  "permissions": ["storage", "sidePanel"],

  "host_permissions": ["https://47.243.178.16/*"],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://47.243.178.16/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "src/inject/interceptor.js",
        "src/content/autopilot/controller.js",
        "src/content/autopilot/turn-detector.js",
        "src/content/autopilot/action-executor.js",
        "src/content/autopilot/dom-locator.js",
        "src/content/autopilot/keep-alive.js",
        "src/common/constants.js"
      ],
      "matches": ["https://47.243.178.16/*"]
    }
  ],

  "action": {
    "default_title": "打开德州托管助手"
  },

  "side_panel": {
    "default_path": "src/panel/panel.html"
  }
}
