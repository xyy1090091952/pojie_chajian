{
  "manifest_version": 3,
  "name": "德州胜率助手",
  "version": "1.0.0",
  "description": "只用你本人可见的数据（你的底牌 + 已翻公共牌 + 存活对手数）实时估算胜率，等价于 PokerStove / Equilab 这类公开胜率计算器。",

  "permissions": ["storage", "sidePanel"],

  "host_permissions": ["https://47.243.178.16/*"],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://47.243.178.16/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "src/inject/interceptor.js",
        "src/content/autopilot/controller.js",
        "src/content/autopilot/turn-detector.js",
        "src/content/autopilot/action-executor.js",
        "src/content/autopilot/dom-locator.js",
        "src/common/constants.js"
      ],
      "matches": ["https://47.243.178.16/*"]
    }
  ],

  "action": {
    "default_title": "打开德州胜率助手"
  },

  "side_panel": {
    "default_path": "src/panel/panel.html"
  }
}
